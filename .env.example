# Required for a live model-backed Deep Agents run
GOOGLE_API_KEY="your-google-api-key"
DEEP_AGENT_MODEL="google_genai:gemini-2.5-flash"

# Optional: use a hosted sandbox backend for code execution
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="ai-data-analysis-agent"

# Optional: switch execution backend behavior
DEEPAGENT_BACKEND="local-shell"
DEEPAGENT_ROOT_DIR="./tmp/data-agent"

# Optional: use OpenAI instead of Google
# OPENAI_API_KEY="your-openai-key"
# DEEP_AGENT_MODEL="openai:gpt-4o-mini"
